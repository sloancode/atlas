# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_local@localhost:5432/atlas
CORS_ORIGINS=http://localhost:3000

# --- Shopify (read-only) ---------------------------------------------------
# Dev Dashboard app installed on your store, using the client credentials grant.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if you already have a legacy admin-created custom app:
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# Background sync cadence in minutes (0 disables; manual sync still works)
SHOPIFY_SYNC_INTERVAL_MINUTES=60

# --- AI analyst (Claude API; separate from Claude Code) -------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Add an AI interpretation to scheduled reports (a few cents each) when a key is set
AI_REPORT_NARRATIVES=true

# --- Market data (optional; added in Phase 5) -----------------------------
MASSIVE_API_KEY=
FMP_API_KEY=
# SEC asks for a descriptive User-Agent with contact info, e.g. "ATLAS research you@example.com"
SEC_USER_AGENT=

# --- eBay (future; intentionally disabled) --------------------------------
EBAY_ENABLED=false
