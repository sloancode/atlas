# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_local@localhost:5432/atlas
CORS_ORIGINS=http://localhost:3000

# --- Alpaca PAPER trading (the bot's account; simulated money) ------------
# Alpaca dashboard -> switch to Paper Trading -> API Keys -> Generate.
# ATLAS only talks to paper-api.alpaca.markets and never places orders from the website.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Daily-bar feed: "iex" works on free accounts; "sip" needs an Alpaca data plan.
ALPACA_DATA_FEED=iex

# --- AI research notes (optional; Claude API, separate from Claude Code) --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Market research data (optional) --------------------------------------
MASSIVE_API_KEY=
FMP_API_KEY=
# SEC asks for a descriptive User-Agent with contact info, e.g. "ATLAS research you@example.com"
SEC_USER_AGENT=
